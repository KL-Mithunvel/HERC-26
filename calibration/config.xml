<?xml version='1.0' encoding='utf-8'?>
<config>

  <rates>
    <sensor_read_hz>1</sensor_read_hz>
    <lcd_refresh_hz>2</lcd_refresh_hz>
  </rates>

  <serial>
    <gps>
      <port>/dev/ttyAMA3</port>
      <baud>9600</baud>
    </gps>
    <!-- MH-Z19C CO2 sensor (UART) -->
    <air>
      <port>/dev/ttyAMA2</port>
      <baud>9600</baud>
    </air>
    <!-- RS485 Modbus bus — shared by PZEM-017 power meter and S-pH-01 pH sensor.
         Both devices use the same UART port and DE/RE GPIO pin via MAX485.
         NOTE: de_re_pin 17 conflicts with WATER_SENSOR_GPIO (also 17).
               Rewire RS485 DE/RE to a free GPIO and update de_re_pin here. -->
    <power>
      <port>/dev/ttyAMA0</port>
      <baud>9600</baud>
      <de_re_pin>18</de_re_pin>
      <modbus_address>248</modbus_address>
      <!-- 248 = 0xF8: PZEM general address (single-slave mode).
           Change to 1 once you assign a real address via FC 0x06 reg 0x0002. -->
    </power>
    <!-- S-pH-01 pH sensor — shares port and de_re_pin with power meter above.
         Address 2 is set via scripts/configure_ph_sensor.py (one-time setup). -->
    <ph>
      <modbus_address>2</modbus_address>
    </ph>
  </serial>

  <gpio>
    <pin name="WATER_SENSOR_GPIO">17</pin>
    <pin name="SOIL_SENSOR_GPIO">27</pin>
    <pin name="AIR_SENSOR_GPIO">22</pin>
    <pin name="LCD_RESET_GPIO">23</pin>
  </gpio>

  <i2c>
    <bus>1</bus>
    <device name="BNO055">
      <address>0x28</address>
    </device>
    <device name="TMP102">
      <address>0x48</address>
    </device>
    <!-- ADS1115 ADC for soil moisture.
         ADDR pin wired to VCC → address 0x49 (avoids conflict with TMP102). -->
    <device name="ADS1115">
      <address>0x49</address>
    </device>
  </i2c>

  <calibration>

    <bno055>
      <mounting>
        <yaw_deg>0.0</yaw_deg>
        <pitch_deg>0.0</pitch_deg>
        <roll_deg>0.0</roll_deg>
      </mounting>
      <offsets>
        <accel x="0" y="0" z="0" />
        <gyro x="0" y="0" z="0" />
        <mag x="0" y="0" z="0" />
      </offsets>
    </bno055>

    <tmp102>
      <temp_offset_c>0.0</temp_offset_c>
    </tmp102>

    <soil_moisture>
      <dry_ref>800</dry_ref>
      <wet_ref>300</wet_ref>
    </soil_moisture>

    <air_sensor>
      <baseline>0.0</baseline>
    </air_sensor>

  </calibration>

  <database>
    <sqlite_path>data/rover_logs.sqlite</sqlite_path>
  </database>

</config>